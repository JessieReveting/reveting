        "7_14_days": "Critical",
        "48_hours_7_days": "Critical",
        "24_48_hours": "Critical",
        "day_of_show": "Critical",
        "post_show": "Warning",
        "post_production": "Informational"
      },
      "reason": "{issue_code} is {adjusted_severity} during {stage}: missing calendar coverage is monitored at 30+ days and becomes show-blocking inside the configured production window."
    },
